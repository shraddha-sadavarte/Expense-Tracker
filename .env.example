# Copy to .env and fill in. Never commit .env.
# Placeholders only — these are local-dev values, not real secrets.

APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=expense
POSTGRES_PASSWORD=change-me
POSTGRES_DB=expense
# Inside Docker the API reaches postgres on 5432. From your laptop it is on
# localhost:5433 (so it never clashes with a locally installed PostgreSQL).
DATABASE_URL=postgresql+psycopg://expense:change-me@postgres:5432/expense

REDIS_URL=redis://redis:6379/0
